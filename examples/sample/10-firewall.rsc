/ip firewall filter add chain=input action=accept protocol=udp dst-port=161 src-address-list="snmp-allowed" comment="GEN-FW:input-snmp"
/ip firewall filter add chain=input action=accept protocol=udp dst-port=53 in-interface-list="lan" comment="GEN-FW:input-dns-udp"
/ip firewall filter add chain=input action=accept protocol=tcp dst-port=53 in-interface-list="lan" comment="GEN-FW:input-dns-tcp"
/ip firewall filter add chain=input action=accept protocol=udp dst-port=5678 in-interface-list="mndp-allowed" comment="GEN-FW:input-mndp"
/ip firewall filter add chain=input action=accept protocol=udp dst-port=67 in-interface-list="lan" comment="GEN-FW:input-dhcp-server"
/ip firewall filter add chain=input action=drop log=yes log-prefix="GEN-FW input drop:" disabled=yes comment="GEN-FW:input-default-drop"
/ip firewall filter add chain=forward action=accept connection-state=established,related comment="GEN-FW:forward-established"
/ip firewall filter add chain=forward action=drop connection-state=invalid comment="GEN-FW:forward-invalid"
/ip firewall filter add chain=forward action=accept protocol=tcp dst-port=22 src-address-list="ssh-allowed" comment="GEN-FW:forward-ssh"
