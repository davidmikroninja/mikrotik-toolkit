# --- Remove objects generated by the previous run ---------------------------
/ip firewall filter remove [find where comment~"^GEN-FW:"]
/ip firewall raw remove [find where comment~"^GEN-FW:"]
/ipv6 firewall filter remove [find where comment~"^GEN-FW:"]
/ipv6 firewall raw remove [find where comment~"^GEN-FW:"]
/ip firewall address-list remove [find where comment~"^GEN-FW:"]
/ipv6 firewall address-list remove [find where comment~"^GEN-FW:"]
/interface list member remove [find where comment~"^GEN-FW:member"]
# --- Interface lists -------------------------------------------------------
:if ([:len [/interface list find where name="wan"]] = 0) do={ /interface list add name="wan" }
:if ([:len [/interface list find where name="lan"]] = 0) do={ /interface list add name="lan" }
:if ([:len [/interface list find where name="management"]] = 0) do={ /interface list add name="management" }
:if ([:len [/interface list find where name="ospf-neighbours"]] = 0) do={ /interface list add name="ospf-neighbours" }
:if ([:len [/interface list find where name="bfd-neighbours"]] = 0) do={ /interface list add name="bfd-neighbours" }
:if ([:len [/interface list find where name="mndp-allowed"]] = 0) do={ /interface list add name="mndp-allowed" }
# --- Interface list members ------------------------------------------------
:if ([:len [/interface find where name="ether1"]] > 0) do={ :if ([:len [/interface list member find where list="wan" and interface="ether1"]] = 0) do={ /interface list member add list="wan" interface="ether1" comment="GEN-FW:member" } }
:if ([:len [/interface find where name="bridge"]] > 0) do={ :if ([:len [/interface list member find where list="lan" and interface="bridge"]] = 0) do={ /interface list member add list="lan" interface="bridge" comment="GEN-FW:member" } }
:if ([:len [/interface find where name="ether2"]] > 0) do={ :if ([:len [/interface list member find where list="management" and interface="ether2"]] = 0) do={ /interface list member add list="management" interface="ether2" comment="GEN-FW:member" } }
:if ([:len [/interface find where name="bridge"]] > 0) do={ :if ([:len [/interface list member find where list="mndp-allowed" and interface="bridge"]] = 0) do={ /interface list member add list="mndp-allowed" interface="bridge" comment="GEN-FW:member" } }
