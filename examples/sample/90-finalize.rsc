:if ([:len [/ipv6 firewall filter find where comment="GEN-FW:forward-default-drop"]] > 0) do={ /ipv6 firewall filter set [find where comment="GEN-FW:forward-default-drop"] disabled=no }
:if ([:len [/ip firewall raw find where comment="GEN-FW:input-default-drop"]] > 0) do={ /ip firewall raw set [find where comment="GEN-FW:input-default-drop"] disabled=no }
:if ([:len [/ipv6 firewall raw find where comment="GEN-FW:input-default-drop"]] > 0) do={ /ipv6 firewall raw set [find where comment="GEN-FW:input-default-drop"] disabled=no }
:log info "GEN: default-deny enabled"
